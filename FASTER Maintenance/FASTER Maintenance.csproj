<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <!-- Legacy pre-nullability code, keep oblivious nullability as authored. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <AssemblyName>FASTER Maintenance</AssemblyName>
    <RootNamespace>FASTER_Maintenance</RootNamespace>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <Version>1.7.1.0</Version>
    <!-- Keep legacy AssemblyInfo.cs (contains wildcard version + COM GUID) -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Legacy AssemblyInfo uses wildcard version 1.7.1.* which requires non-deterministic build -->
    <Deterministic>false</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
