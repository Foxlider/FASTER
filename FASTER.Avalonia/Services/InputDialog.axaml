<Window x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FASTER.Avalonia.Services.InputDialog"
        Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FasterWindowBackground}">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <TextBox x:Name="InputBox" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Classes="accent" Content="OK" Click="Ok_Click" IsDefault="True" />
      <Button Content="Cancel" Click="Cancel_Click" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
