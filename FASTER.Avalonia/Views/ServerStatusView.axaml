<UserControl x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dg="using:Avalonia.Controls"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:converters="clr-namespace:FASTER.Avalonia.Converters;assembly=FASTER.Avalonia"
             x:Class="FASTER.Avalonia.Views.ServerStatusView">
  <UserControl.Resources>
    <converters:FolderSizeConverter x:Key="SizeConverter" />
  </UserControl.Resources>
  <Grid RowDefinitions="*,Auto,2*,Auto" Margin="5">
    <Grid ColumnDefinitions="*,*" RowDefinitions="*,Auto,Auto" MinHeight="150">
      <lvc:PieChart x:Name="CpuGauge" InitialRotation="180" MaxAngle="180" MaxValue="100" TooltipPosition="Hidden" />
      <lvc:PieChart Grid.Column="1" x:Name="RamGauge" InitialRotation="180" MaxAngle="180" MaxValue="100" TooltipPosition="Hidden" />
      <TextBlock Grid.Row="0" x:Name="CpuLabel" Text="Unavailable" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,15" FontSize="24" />
      <TextBlock Grid.Row="0" Grid.Column="1" x:Name="RamPercentLabel" Text="Unavailable" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,15" FontSize="24" />
      <TextBlock Grid.Row="1" Text="CPU Usage" HorizontalAlignment="Center" FontWeight="Bold" />
      <TextBlock Grid.Row="1" Grid.Column="1" Text="Memory Usage" HorizontalAlignment="Center" FontWeight="Bold" />
      <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RamLabel" HorizontalAlignment="Center" Margin="0,4" Foreground="{DynamicResource FasterMutedText}" />
    </Grid>
    <Expander Grid.Row="1" Classes="bar" Header="Additional Gauges" HorizontalAlignment="Stretch" Margin="5">
      <Grid RowDefinitions="*,Auto">
        <lvc:CartesianChart Height="120" x:Name="CpuChart" TooltipPosition="Hidden" />
        <TextBlock Grid.Row="1" Text="CPU usage history · CPU temperature unavailable" HorizontalAlignment="Center" Margin="5" />
      </Grid>
    </Expander>
    <dg:DataGrid Grid.Row="2" x:Name="ProcessGrid" AutoGenerateColumns="False" CanUserSortColumns="True" Margin="10,5">
      <dg:DataGrid.Columns>
        <dg:DataGridTextColumn Header="Process ID" Binding="{Binding Id}" IsReadOnly="True" />
        <dg:DataGridTextColumn Header="Name" Binding="{Binding ProcessName}" Width="*" IsReadOnly="True" />
        <dg:DataGridTextColumn Header="Memory" Binding="{Binding WorkingSet64, Converter={StaticResource SizeConverter}}" IsReadOnly="True" />
        <dg:DataGridTemplateColumn Header="" CanUserSort="False" CanUserResize="False">
          <dg:DataGridTemplateColumn.CellTemplate>
            <DataTemplate><Button Classes="accent" Content="Kill" Click="KillProcess_Click" /></DataTemplate>
          </dg:DataGridTemplateColumn.CellTemplate>
        </dg:DataGridTemplateColumn>
      </dg:DataGrid.Columns>
    </dg:DataGrid>
    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="10,5">
      <StackPanel Orientation="Horizontal" Spacing="5">
        <Button Classes="accent" Content="Rescan" Click="Rescan_Click" />
        <Button Classes="accent" Content="Kill all" Click="KillAll_Click" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Refresh interval" VerticalAlignment="Center" />
        <ComboBox x:Name="IntervalBox" SelectedIndex="2" SelectionChanged="IntervalBox_SelectionChanged" MinWidth="90">
          <ComboBoxItem Content="100 ms" /><ComboBoxItem Content="250 ms" /><ComboBoxItem Content="500 ms" />
          <ComboBoxItem Content="1 s" /><ComboBoxItem Content="2 s" /><ComboBoxItem Content="5 s" />
        </ComboBox>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
