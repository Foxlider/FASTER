<UserControl x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dg="using:Avalonia.Controls"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:converters="clr-namespace:FASTER.Avalonia.Converters;assembly=FASTER.Avalonia"
             x:Class="FASTER.Avalonia.Views.ServerStatusView">
  <UserControl.Resources>
    <converters:FolderSizeConverter x:Key="SizeConverter" />
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,Auto,*" Margin="8">
    <Grid Grid.Row="0" ColumnDefinitions="*,*" Margin="0,0,0,8">
      <StackPanel Grid.Column="0" Margin="0,0,8,0" Spacing="4">
        <TextBlock Text="CPU" FontWeight="Bold" />
        <ProgressBar x:Name="CpuBar" Minimum="0" Maximum="100" Height="20" />
        <TextBlock x:Name="CpuLabel" Text="0 %" />
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="4">
        <TextBlock Text="Memory" FontWeight="Bold" />
        <ProgressBar x:Name="RamBar" Minimum="0" Maximum="100" Height="20" />
        <TextBlock x:Name="RamLabel" Text="0 B" />
      </StackPanel>
    </Grid>
    <lvc:CartesianChart Grid.Row="1" Height="160" x:Name="CpuChart"
                        TooltipPosition="Hidden" />
    <Grid Grid.Row="2" RowDefinitions="Auto,*">
      <WrapPanel Margin="0,8">
        <Button Content="Rescan" Margin="0,0,8,0" Click="Rescan_Click" />
        <Button Content="Kill all" Click="KillAll_Click" />
      </WrapPanel>
      <dg:DataGrid Grid.Row="1" x:Name="ProcessGrid" AutoGenerateColumns="False"
                   CanUserSortColumns="True" Margin="0,8,0,0">
        <dg:DataGrid.Columns>
          <dg:DataGridTextColumn Header="PID" Binding="{Binding Id}" IsReadOnly="True" />
          <dg:DataGridTextColumn Header="Name" Binding="{Binding ProcessName}" Width="*" IsReadOnly="True" />
          <dg:DataGridTextColumn Header="Memory" Binding="{Binding WorkingSet64, Converter={StaticResource SizeConverter}}" IsReadOnly="True" />
          <dg:DataGridTemplateColumn Header="" CanUserSort="False" CanUserResize="False">
            <dg:DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="Kill" Click="KillProcess_Click" />
              </DataTemplate>
            </dg:DataGridTemplateColumn.CellTemplate>
          </dg:DataGridTemplateColumn>
        </dg:DataGrid.Columns>
      </dg:DataGrid>
    </Grid>
  </Grid>
</UserControl>
