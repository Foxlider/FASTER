<UserControl x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FASTER.Avalonia.Views.SetupView">
  <UserControl.Styles>
    <!-- These fields already have labels; do not reserve a floating-watermark row. -->
    <Style Selector="TextBox">
      <Setter Property="UseFloatingWatermark" Value="False" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top">
    <Border Classes="card" Margin="10" MaxWidth="760"
            HorizontalAlignment="Stretch" VerticalAlignment="Top">
      <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="Welcome to FASTER" FontSize="20" FontWeight="Light" />
        <TextBlock x:Name="MessageText" Foreground="OrangeRed" TextWrapping="Wrap" />
        <StackPanel Spacing="4">
          <TextBlock Text="Arma server directory" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox x:Name="ServerDirBox" ToolTip.Tip="{Binding #ServerDirBox.Text}" />
            <Button Grid.Column="1" Classes="accent" Content="Browse" Margin="8,0,0,0"
                    VerticalAlignment="Stretch" VerticalContentAlignment="Center" Click="ServerDirButton_Click" />
          </Grid>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="Mod staging directory" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox x:Name="ModStagingBox" ToolTip.Tip="{Binding #ModStagingBox.Text}" />
            <Button Grid.Column="1" Classes="accent" Content="Browse" Margin="8,0,0,0"
                    VerticalAlignment="Stretch" VerticalContentAlignment="Center" Click="ModStagingButton_Click" />
          </Grid>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="Steam username" />
          <TextBox x:Name="SteamUserBox" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="Steam password (stored encrypted)" />
          <TextBox x:Name="SteamPassBox" PasswordChar="*" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="Steam API key (optional)" />
          <TextBox x:Name="ApiKeyBox" />
        </StackPanel>
        <Button Classes="accent" Content="Continue" HorizontalAlignment="Right" Click="Continue_Click" />
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
