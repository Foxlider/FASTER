<UserControl x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FASTER.Avalonia.Views.SettingsView">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="10" MaxWidth="600">
      <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" />
      <TextBlock Text="Theme" />
      <ComboBox x:Name="ThemeBox" SelectionChanged="ThemeBox_SelectionChanged">
        <ComboBoxItem Content="Dark" />
        <ComboBoxItem Content="Light" />
      </ComboBox>
      <CheckBox x:Name="ModUpdatesBox" Content="Check for mod updates on launch"
                IsCheckedChanged="ModUpdatesBox_Changed" />
      <CheckBox x:Name="AppUpdatesBox" Content="Check for app updates on launch"
                IsCheckedChanged="AppUpdatesBox_Changed" />
      <TextBlock Text="Steam API key" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0" x:Name="ApiKeyBox" />
        <Button Grid.Column="1" Content="Get key" Margin="8,0,0,0" Click="ApiKeyButton_Click" />
      </Grid>
      <TextBlock Text="Download workers" />
      <Slider x:Name="WorkersSlider" Minimum="1" Maximum="32" ValueChanged="WorkersSlider_Changed" />
      <TextBlock x:Name="UpdateMessage" TextWrapping="Wrap" />
      <WrapPanel>
        <Button Content="Save" Margin="0,0,8,0" Click="Save_Click" />
        <Button Content="Check for app update" Margin="0,0,8,0" Click="CheckUpdate_Click" />
        <Button Content="Reset FASTER" Click="Reset_Click" />
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
