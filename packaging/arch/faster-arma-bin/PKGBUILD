pkgname=faster-arma-bin
pkgver=1.9.8
pkgrel=1
pkgdesc='Arma 3 server and Workshop mod manager (prebuilt Avalonia binary)'
arch=('x86_64')
url='https://github.com/Foxlider/FASTER'
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'libglvnd' 'xdg-utils')
makedepends=('squashfs-tools')
optdepends=('ttf-dejavu: fallback UI font')
provides=('faster-arma')
conflicts=('faster-arma' 'faster-arma-git')
options=('!strip' '!debug')
# Local candidate: replace this with the immutable release URL after publication.
source=('FASTER.AppImage' 'faster-arma.desktop' 'faster-arma.png')
noextract=('FASTER.AppImage')
sha256sums=('f997e6eeef894c605c527a188fe6422e7bf5401464b80be30c500d3bf0e8c050' 'e7daddb150c22da0e0321e81af1f9062e76d62f0a40eadfb7b6726989886fc30' '6b15841b7eaaeec9c4af96545fc2e045ad7a058ed612df13ee2e70d08c0a53a2')

prepare() {
    cd "$srcdir"
    chmod +x FASTER.AppImage
    ./FASTER.AppImage --appimage-extract >/dev/null
}

package() {
    install -dm755 "$pkgdir/opt/faster-arma" "$pkgdir/usr/bin"
    cp -a "$srcdir/squashfs-root/usr/bin/." "$pkgdir/opt/faster-arma/"
    printf '#!/bin/sh\nexec /opt/faster-arma/faster-arma "$@"\n' > "$pkgdir/usr/bin/faster-arma"
    chmod 755 "$pkgdir/usr/bin/faster-arma"
    install -Dm644 "$srcdir/faster-arma.desktop" "$pkgdir/usr/share/applications/faster-arma.desktop"
    install -Dm644 "$srcdir/faster-arma.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/faster-arma.png"
}
